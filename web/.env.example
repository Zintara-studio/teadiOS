# The console. Copy to .env.local for dev; set the same keys in the Vercel project.
#
# Everything in this file is compiled into the bundle and served to the browser.
# That is not an oversight — there is no secret in the web tier because
# authorization is row-level security in Postgres, not a hidden key. If you ever
# feel the need to put a secret here, the design has gone wrong somewhere.

VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
VITE_NEON_DATA_API_URL=https://ep-example.apirest.us-east-2.aws.neon.tech/neondb/rest/v1
VITE_UPLOAD_URL=https://teadio-upload.example.workers.dev
VITE_CDN_BASE=https://cdn.example.com
