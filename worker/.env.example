# One of these per laptop. Copy to worker/.env — it is gitignored, and it is real
# secrets on someone's personal machine.

# --- identity -----------------------------------------------------------------
# MACHINE is per BOX; hostname is per PROCESS and is derived as $MACHINE.slotN.
# They are different things: jobs pin to a machine, never to a slot, because what
# makes a machine special is its disk. If both were the same, N processes would
# upsert one row and fight over its heartbeat — and a dead worker's job would
# look alive forever, so nothing would ever reclaim it.
TEADIO_MACHINE=mira-mbp
TEADIO_SLOTS=2

# Clerk user id of whoever owns this laptop. Lets the console show whose fans are
# spinning, and lets them pause their own machine from the browser.
TEADIO_OWNER_ID=user_replace_me

# --- database -----------------------------------------------------------------
# Connects as teadio_w1, which holds the teadio_worker grants. That role cannot
# read project members, invitations, or who submitted a job.
TEADIO_DATABASE_URL=postgresql://teadio_w1:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require

TEADIO_POLL_MS=2000
# Must stay well under teadio.stale_after() (45s). Too slow and a healthy job
# gets reclaimed out from under a laptop that is still rendering it.
TEADIO_HEARTBEAT_MS=15000

# --- being a good guest on someone's laptop -----------------------------------
TEADIO_REQUIRE_AC=true
# Refuse in preflight. Nothing in a concurrency limiter knows about disk, and an
# out-of-space error mid-run costs the whole run and can corrupt build caches.
TEADIO_MIN_FREE_DISK_GB=25
# Blank lets Remotion choose from core count.
TEADIO_MAX_CONCURRENCY=

# --- artifacts ----------------------------------------------------------------
# Uploaded before the job is marked complete. A render that could not upload is a
# failure, not a success.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=teadio-artifacts
TEADIO_CDN_BASE=https://cdn.example.com

# --- kind='generate' only -----------------------------------------------------
# The headless agent that authors a composition from a script. Leave blank on
# laptops you only want doing plain renders.
TEADIO_AGENT_CMD=claude
ANTHROPIC_API_KEY=
